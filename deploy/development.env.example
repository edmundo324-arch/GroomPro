# Separate app and database. DB user must have no grants on live or staging data.
# Supply DATABASE_URL for a database ending in _development through hosting secrets.
GROOMPRO_SITE_ROLE=development
GROOMPRO_SITE_HOSTS=dev.example.com
GROOMPRO_LIVE_DATABASE_NAME=REPLACE_WITH_ACTUAL_LIVE_DATABASE_NAME
GROOMPRO_SUBDOMAIN_ROUTING_ENABLED=false
