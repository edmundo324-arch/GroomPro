generator client { provider = "prisma-client-js" }
datasource db { provider = "mysql" url = env("DATABASE_URL") }
enum UserRole {
 ADMIN
 MANAGER
 FLOOR_MANAGER
 FRONT
 BACK
 MASTER_GROOMER
 GROOMER
 SALES
}
enum TicketStatus {
 OPEN
 CONFIRMED
 CHECKED_IN
 IN_PROGRESS
 READY
 CLOSED
 CANCELLED
}
enum AuditActorType {
 EMPLOYEE
 SYSTEM
}
enum AuditEntityType {
 TENANT
 LOCATION
 USER
 CUSTOMER
 PET
 VACCINATION
 TICKET
 PAYMENT
 COMMUNICATION
 MEMBERSHIP
 INVENTORY_ITEM
 SHIPMENT
 BACKBAR_TICKET
}
enum CommunicationChannel {
 SMS
 EMAIL
}
enum CommunicationDirection {
 INBOUND
 OUTBOUND
}
enum PaymentType {
 CASH
 VISA
 MASTERCARD
 AMEX
 DISCOVER
 DEBIT
 GIFT_CARD
 OTHER
}
enum TicketLineType {
 SERVICE
 PRODUCT
}
enum TicketLineRole {
 PREP
 BATH
 GROOM
 ADD_ON
 PRODUCT
}
enum BookingSource {
 STAFF
 ONLINE
}
enum OnlineBookingCategory {
 GROOMING
 FULL_WASH
 NAIL_GRINDING
 SELFSERVICE
 DAYCARE
 BOARDING
}
enum TicketScheduleChangeType {
 CREATED
 MOVED
}
enum AnalSituationStatus {
 DONE_REQUESTED
 DONE_NOT_REQUESTED
 NOT_NEEDED
}
enum VipAvailability {
 AVAILABLE
 NOT_AVAILABLE
 NEEDS_MORE_SESSIONS
}
enum DaycareStatus {
 NONE
 STAYING
}
model Tenant { id String @id @default(cuid()) name String subscription Subscription? locations Location[] users User[] sessions EmployeeSession[] customers Customer[] customerPhones CustomerPhone[] pets Pet[] vaccinations Vaccination[] tickets Ticket[] payments Payment[] communications Communication[] services Service[] products Product[] auditEntries AuditEntry[] onlineBookingRules OnlineBookingRule[] ticketScheduleHistory TicketScheduleHistory[] whiteboardSnapshots WhiteboardSnapshot[] tenantFeatures TenantFeature[] rolePermissions RolePermission[] settings TenantSetting[] servicePricing LocationServicePricing[] packages Package[] packageItems PackageItem[] packagePricing LocationPackagePricing[] customerLocationAccess CustomerLocationAccess[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([name]) }
model Subscription { id String @id @default(cuid()) tenantId String @unique plan String status String @default("active") externalId String? startedAt DateTime @default(now()) renewsAt DateTime? cancelledAt DateTime? tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) }
model SubscriptionPlan { id String @id @default(cuid()) code String @unique name String monthlyCents Int active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Location { id String @id @default(cuid()) tenantId String name String address1 String? address2 String? city String? state String? postalCode String? timezone String @default("America/Chicago") tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) users User[] tickets Ticket[] onlineBookingRules OnlineBookingRule[] whiteboardSnapshots WhiteboardSnapshot[] servicePricing LocationServicePricing[] packagePricing LocationPackagePricing[] customerAccess CustomerLocationAccess[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId]) }
model User { id String @id @default(cuid()) tenantId String locationId String? firstName String lastName String email String? pinHash String role UserRole @default(FRONT) active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location? @relation(fields:[locationId],references:[id],onDelete:SetNull) auditEntries AuditEntry[] sessions EmployeeSession[] ticketAssignments TicketAssignment[] lineAssignments TicketLine[] scheduleChanges TicketScheduleHistory[] daycareAddedTickets Ticket[] @relation("DaycareAddedBy") whiteboardSnapshotsCreated WhiteboardSnapshot[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([tenantId,email]) @@index([tenantId,active]) @@index([tenantId,lastName,firstName]) }
model EmployeeSession { id String @id @default(cuid()) tenantId String userId String deviceId String startedAt DateTime @default(now()) lastActiveAt DateTime @default(now()) endedAt DateTime? tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([tenantId,deviceId,endedAt]) @@index([tenantId,userId,endedAt]) }
model Customer { id String @id @default(cuid()) tenantId String firstName String lastName String email String? address1 String? address2 String? city String? state String? postalCode String? notes String? @db.Text active Boolean @default(true) vipStatus String? loyaltyPoints Int @default(0) balanceCents Int @default(0) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) phones CustomerPhone[] pets Pet[] tickets Ticket[] communications Communication[] auditEntries AuditEntry[] locationAccess CustomerLocationAccess[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId,lastName,firstName]) @@index([tenantId,email]) }
model CustomerPhone { id String @id @default(cuid()) tenantId String customerId String number String normalized String label String? isPrimary Boolean @default(false) smsEnabled Boolean @default(true) callEnabled Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) @@unique([tenantId,normalized]) @@index([tenantId,customerId]) }
model Pet { id String @id @default(cuid()) tenantId String customerId String name String breed String? notes String? @db.Text active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) vaccinations Vaccination[] ticketPets TicketPet[] ticketLines TicketLine[] auditEntries AuditEntry[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId,customerId]) @@index([tenantId,name]) }
model Vaccination { id String @id @default(cuid()) tenantId String customerId String petId String vaccineName String administeredAt DateTime expiresAt DateTime? documentUrl String? notes String? @db.Text tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) pet Pet @relation(fields:[petId],references:[id],onDelete:Cascade) auditEntries AuditEntry[] createdAt DateTime @default(now()) @@index([tenantId,customerId]) @@index([tenantId,petId]) }
model Ticket { id String @id @default(cuid()) tenantId String locationId String customerId String orderNumber Int scheduledStart DateTime? durationMin Int @default(0) status TicketStatus @default(OPEN) bookingSource BookingSource @default(STAFF) onlineCategory OnlineBookingCategory? bookingDecision String @default("INTERNAL") requestedAt DateTime? checkedInAt DateTime? pickupAt DateTime? pickupCompletedAt DateTime? arrivalPriority Int? daycareStatus DaycareStatus @default(NONE) daycareAddedAt DateTime? daycareAddedByUserId String? notes String? @db.Text tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Restrict) customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict) daycareAddedByUser User? @relation("DaycareAddedBy",fields:[daycareAddedByUserId],references:[id],onDelete:SetNull) pets TicketPet[] lines TicketLine[] assignments TicketAssignment[] payments Payment[] communications Communication[] auditEntries AuditEntry[] scheduleHistory TicketScheduleHistory[] whiteboardSnapshotItems WhiteboardSnapshotItem[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt closedAt DateTime? @@unique([tenantId,orderNumber]) @@index([tenantId,locationId,scheduledStart]) @@index([tenantId,customerId,createdAt]) @@index([tenantId,customerId,scheduledStart]) @@index([tenantId,bookingSource,bookingDecision]) @@index([tenantId,locationId,arrivalPriority]) @@index([tenantId,locationId,daycareStatus]) }
model TicketScheduleHistory { id String @id @default(cuid()) tenantId String ticketId String actorUserId String? changeType TicketScheduleChangeType previousStart DateTime? newStart DateTime changedAt DateTime @default(now()) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) actor User? @relation(fields:[actorUserId],references:[id],onDelete:SetNull) @@index([tenantId,ticketId,changedAt]) @@index([tenantId,actorUserId,changedAt]) }
model TicketPet { id String @id @default(cuid()) ticketId String petId String weightLbs Decimal? @db.Decimal(6,2) analSituation AnalSituationStatus? vipAvailability VipAvailability? ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) pet Pet @relation(fields:[petId],references:[id],onDelete:Restrict) @@unique([ticketId,petId]) @@index([petId]) }
model TicketAssignment { id String @id @default(cuid()) ticketId String userId String role String assignedAt DateTime @default(now()) ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Restrict) @@unique([ticketId,userId,role]) @@index([userId,assignedAt]) }
model Payment { id String @id @default(cuid()) tenantId String ticketId String amount Decimal @db.Decimal(10,2) paymentType PaymentType externalId String? paidAt DateTime @default(now()) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) auditEntries AuditEntry[] @@index([tenantId,ticketId,paidAt]) }
model Communication { id String @id @default(cuid()) tenantId String customerId String ticketId String? channel CommunicationChannel direction CommunicationDirection fromAddress String? toAddress String? subject String? body String @db.Text sentAt DateTime? receivedAt DateTime? externalId String? createdAt DateTime @default(now()) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) ticket Ticket? @relation(fields:[ticketId],references:[id],onDelete:SetNull) @@index([tenantId,customerId,createdAt]) @@index([tenantId,ticketId,createdAt]) }
model AuditEntry { id String @id @default(cuid()) tenantId String actorType AuditActorType actorUserId String? entityType AuditEntityType entityId String customerId String? action String summary String details Json? occurredAt DateTime @default(now()) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) actorUser User? @relation(fields:[actorUserId],references:[id],onDelete:SetNull) customer Customer? @relation(fields:[customerId],references:[id],onDelete:SetNull) @@index([tenantId,entityType,entityId,occurredAt]) @@index([tenantId,customerId,occurredAt]) @@index([tenantId,actorUserId,occurredAt]) }
model OnlineBookingRule { id String @id @default(cuid()) tenantId String locationId String category OnlineBookingCategory enabled Boolean @default(false) requestOnly Boolean @default(true) advanceDays Int @default(30) sameCustomerOverlapBlocked Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) @@unique([locationId,category]) @@index([tenantId,enabled]) }
model TicketLine { id String @id @default(cuid()) ticketId String lineType TicketLineType role TicketLineRole @default(ADD_ON) serviceId String? productId String? petId String? description String quantity Int @default(1) unitPriceCents Int @default(0) discountCents Int @default(0) totalCents Int @default(0) commissionPct Decimal? @db.Decimal(5,2) commissionCents Int @default(0) sortOrder Int @default(0) assignedUserId String? assignedAt DateTime? ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull) product Product? @relation(fields:[productId],references:[id],onDelete:SetNull) pet Pet? @relation(fields:[petId],references:[id],onDelete:SetNull) assignedUser User? @relation(fields:[assignedUserId],references:[id],onDelete:SetNull) @@index([ticketId,petId,sortOrder]) @@index([serviceId]) @@index([productId]) @@index([assignedUserId]) }
model Service { id String @id @default(cuid()) tenantId String name String category String? description String? @db.Text priceCents Int @default(0) durationMin Int @default(30) active Boolean @default(true) commissionPct Decimal? @db.Decimal(5,2) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) ticketLines TicketLine[] locationPricing LocationServicePricing[] packageItems PackageItem[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId,active,category]) @@index([tenantId,name]) }
model Product { id String @id @default(cuid()) tenantId String sku String? name String description String? @db.Text priceCents Int @default(0) costCents Int @default(0) quantity Int @default(0) active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) ticketLines TicketLine[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([tenantId,active]) @@index([tenantId,name]) @@unique([tenantId,sku]) }
model WhiteboardSnapshot { id String @id @default(cuid()) tenantId String locationId String businessDate DateTime snapshotAt DateTime @default(now()) createdByUserId String tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) createdBy User @relation(fields:[createdByUserId],references:[id],onDelete:Restrict) items WhiteboardSnapshotItem[] @@unique([locationId,businessDate]) @@index([tenantId,locationId,businessDate]) }
model WhiteboardSnapshotItem { id String @id @default(cuid()) snapshotId String ticketId String sequence Int scheduledStartAtPush DateTime? snapshot WhiteboardSnapshot @relation(fields:[snapshotId],references:[id],onDelete:Cascade) ticket Ticket @relation(fields:[ticketId],references:[id],onDelete:Cascade) @@unique([snapshotId,ticketId]) @@unique([snapshotId,sequence]) @@index([ticketId]) }
model FeatureModule { id String @id @default(cuid()) code String @unique name String description String? active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tenantFeatures TenantFeature[] }
model TenantFeature { id String @id @default(cuid()) tenantId String featureCode String enabled Boolean @default(true) config Json? tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) @@unique([tenantId,featureCode]) @@index([tenantId,enabled]) }
model RolePermission { id String @id @default(cuid()) tenantId String role UserRole permissionCode String enabled Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) @@unique([tenantId,role,permissionCode]) @@index([tenantId,role,enabled]) }
model TenantSetting { id String @id @default(cuid()) tenantId String settingKey String value Json? tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) @@unique([tenantId,settingKey]) @@index([tenantId,settingKey]) }
model LocationServicePricing { id String @id @default(cuid()) tenantId String locationId String serviceId String priceAdjustmentPct Decimal @default(0) @db.Decimal(7,3) priceOverrideCents Int? active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade) @@unique([locationId,serviceId]) @@index([tenantId,locationId,active]) }
model Package { id String @id @default(cuid()) tenantId String name String description String? basePriceCents Int active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) items PackageItem[] locationPricing LocationPackagePricing[] @@index([tenantId,active]) }
model PackageItem { id String @id @default(cuid()) tenantId String packageId String serviceId String? quantity Int @default(1) sortOrder Int @default(0) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) package Package @relation(fields:[packageId],references:[id],onDelete:Cascade) service Service? @relation(fields:[serviceId],references:[id],onDelete:SetNull) @@index([tenantId,packageId,sortOrder]) }
model LocationPackagePricing { id String @id @default(cuid()) tenantId String locationId String packageId String priceAdjustmentPct Decimal @default(0) @db.Decimal(7,3) priceOverrideCents Int? active Boolean @default(true) tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) package Package @relation(fields:[packageId],references:[id],onDelete:Cascade) @@unique([locationId,packageId]) @@index([tenantId,locationId,active]) }
model CustomerLocationAccess { id String @id @default(cuid()) tenantId String customerId String locationId String tenant Tenant @relation(fields:[tenantId],references:[id],onDelete:Cascade) customer Customer @relation(fields:[customerId],references:[id],onDelete:Cascade) location Location @relation(fields:[locationId],references:[id],onDelete:Cascade) @@unique([customerId,locationId]) @@index([tenantId,customerId]) @@index([tenantId,locationId]) }
