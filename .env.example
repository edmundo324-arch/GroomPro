# GroomPro database configuration
# Choose the GoDaddy-injected DB_* variables OR an explicit DATABASE_URL.
# A nonempty DATABASE_URL takes precedence. Remove any placeholder URL when using DB_*.
# DB_HOST=your-database-host
# DB_PORT=3306
# DB_NAME=your-database-name
# DB_USER=your-database-user
# DB_PASSWORD=your-database-password
# DATABASE_URL=mysql://ENCODED_USER:ENCODED_PASSWORD@HOST:3306/DATABASE
# Preserve your provider's TLS query parameters when supplying DATABASE_URL.

# GoDaddy supplies PORT. The app binds to 0.0.0.0.
NODE_ENV=production
# Setup secret is needed only for the explicit demo-data setup endpoint.
# GROOMPRO_SETUP_SECRET=your-long-random-secret
# Optional business context; existing browser tenant cookies also work.
# GROOMPRO_DEV_TENANT_ID=existing-tenant-id
HEYROSIE_ZAPIER_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
