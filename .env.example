# GroomPro environment variables
# GoDaddy Hosted Database injects DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASSWORD.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
GROOMPRO_SETUP_SECRET="replace-with-a-long-random-secret"
HEYROSIE_ZAPIER_SECRET="replace-with-a-long-random-webhook-secret"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
