{
  "name": "groompro",
  "version": "0.1.4",
  "private": true,
  "main": "scripts/godaddy-start.cjs",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && npm run db:sql && next build",
    "start": "node scripts/godaddy-start.cjs",
    "lint": "tsc --noEmit",
    "db:sql": "node scripts/build-godaddy-schema-sql.cjs",
    "db:bootstrap": "node scripts/bootstrap-godaddy.cjs",
    "db:verify": "node scripts/bootstrap-godaddy.cjs --verify-only",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node scripts/test-database.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "next": "^15.5.0",
    "prisma": "^6.15.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "mysql2": "^3.14.4",
    "typescript": "^5.8.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22 <23"
  }
}
